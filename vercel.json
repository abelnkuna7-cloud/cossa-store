{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "pre": "cossa-store",
            "suf": ".vercel.app"
          }
        }
      ],
      "destination": "https://store.cossanexusholdings.co.za/:path*",
      "permanent": true
    }
  ]
}
